@base = http://localhost:8080/api/v1

### catalog: 주문용 상품 A 생성
POST {{base}}/products
Content-Type: application/json

{
  "name": "orderProduct-A",
  "description": "for order test A",
  "categoryId": 10,
  "productStatus": "ACTIVE",
  "skuCode": "order-A-001",
  "price": 3000,
  "stock": 5
}

> {%
  client.global.set("productIdA", response.body.productId?.toFixed ? response.body.productId.toFixed(0) : String(response.body.productId));
  client.global.set("skuA", "order-A-001");
  client.global.set("skuA", "order-A-001")
>>>>>>> Stashed changes
%}

### catalog: 주문용 상품 B 생성
POST {{base}}/products
Content-Type: application/json

{
  "name": "orderProduct-B",
  "description": "for order test B",
  "categoryId": 10,
  "productStatus": "ACTIVE",
  "skuCode": "order-B-001",
  "price": 10000,
  "stock": 2
}

> {%
  client.global.set("productIdB", response.body.productId?.toFixed ? response.body.productId.toFixed(0) : String(response.body.productId));
  client.global.set("skuB", "order-B-001");
  client.global.set("skuB", "order-B-001")
>>>>>>> Stashed changes
%}

### ordering: 주문 생성 #1 (성공)
POST {{base}}/orders
Content-Type: application/json

{
  "items": [
    { "productId": {{productIdA}}, "skuCode": "{{skuA}}", "quantity": 2 },
    { "productId": {{productIdB}}, "skuCode": "{{skuB}}", "quantity": 1 }
  ],
  "address": {
    "receiverName": "홍길동",
    "phone": "010-1234-5678",
    "zipcode": "06236",
    "address1": "서울 강남구 테헤란로 00",
    "address2": "101동 202호"
  }
}

> {%
  client.global.set("orderId", response.body.orderId.toFixed(0))
%}


### ordering: 주문 생성 #2 (성공, 합계 다르게)
POST {{base}}/orders
Content-Type: application/json

{
  "items": [
    { "productId": {{productIdA}}, "skuCode": "{{skuA}}", "quantity": 1 }
  ],
  "address": {
    "receiverName": "이몽룡",
    "phone": "010-0000-0000",
    "zipcode": "04524",
    "address1": "서울 중구 세종대로 00",
    "address2": "N/A"
  }
}

> {%
  client.global.set("orderId2", String(response.body.orderId));
%}

### ordering: 주문 상세 조회 (검증)
GET {{base}}/orders/{{orderId1}}

###
GET {{base}}/orders/{{orderId2}}

### ordering: 주문 목록 - 기본(최신순, createdAt desc)
GET {{base}}/orders?sort=createdAt&order=desc&page=0&size=20

### ordering: 주문 목록 - 합계 오름차순(totalAmount asc)
GET {{base}}/orders?sort=totalAmount&order=asc&page=0&size=20

### ordering: 주문 목록 - 페이지네이션 확인 (size=1로 나눠서 page0/page1)
GET {{base}}/orders?sort=createdAt&order=desc&page=0&size=1

###
GET {{base}}/orders?sort=createdAt&order=desc&page=1&size=1

### ordering: 주문 목록 - 상태/기간/금액/키워드 조합
# from/to는 예시 날짜. 필요 시 프로젝트 시간대 기준으로 수정하세요.
GET {{base}}/orders?status=CREATED&from=2025-09-01T00:00:00&to=2025-10-01T00:00:00&minTotal=1000&maxTotal=500000&keyword=orderProduct&sort=createdAt&order=desc&page=0&size=20

### ordering: 주문 목록 - SKU 키워드로 검색
GET {{base}}/orders?keyword={{skuA}}&page=0&size=20

### ordering: 주문 목록 - 특정 사용자(createdBy) 필터 (예: 0)
GET {{base}}/orders?createdBy=0&sort=createdAt&order=desc&page=0&size=20

### ordering: 주문 목록 - 잘못된 금액 범위(예상: 400)
GET {{base}}/orders?minTotal=999999&maxTotal=100

### ordering: 주문 목록 - 잘못된 날짜 범위(예상: 400)
GET {{base}}/orders?from=2025-10-01T00:00:00&to=2025-09-01T00:00:00
